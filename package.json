{
  "name": "vet-ultrasound-automation",
  "version": "2.1.2",
  "description": "Plataforma SaaS Multi-Tenant de Laudos de Ultrassom e Relatórios Cirúrgicos Veterinários (Vetaro / UPA PET - PostgreSQL + Prisma + React).",
  "main": "servidor_web.js",
  "scripts": {
    "start": "node servidor_web.js",
    "start:monitor": "node monitor_exames.js",
    "start:web": "node servidor_web.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .js",
    "db:generate": "npx prisma generate",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.js",
    "db:seed": "node seed.js"
  },
  "keywords": [
    "veterinary",
    "vetaro",
    "ultrasound",
    "surgery",
    "reports",
    "automation",
    "gemini-ai",
    "postgresql",
    "prisma",
    "react",
    "multitenant"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "chokidar": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^189.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "p-queue": "6.6.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.22.0",
    "puppeteer": "^25.17.0",
    "redis": "^6.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!**/tests/**",
      "!**/node_modules/**",
      "!**/frontend/**",
      "!*.config.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
