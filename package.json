{
  "name": "vet-ultrasound-automation",
  "version": "1.0.0",
  "description": "Central Inteligente de Laudos de Ultrassom e Relatórios Cirúrgicos da UPA PET (Dra. Camila Bastos - CRMV/MG: 22904).",
  "main": "monitor_exames.js",
  "scripts": {
    "postinstall": "npx puppeteer browsers install chrome",
    "start": "node servidor_web.js",
    "start:monitor": "node monitor_exames.js",
    "start:web": "node servidor_web.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .js",
    "db:migrate": "node scripts/migrate-to-sqlite.js",
    "db:seed": "node scripts/seed-sqlite.js"
  },
  "keywords": [
    "veterinary",
    "ultrasound",
    "surgery",
    "reports",
    "automation",
    "gemini-ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^189.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "puppeteer": "^25.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!**/tests/**",
      "!**/node_modules/**",
      "!*.config.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
