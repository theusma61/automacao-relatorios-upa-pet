datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Clinica {
  id           String               @id @default(cuid())
  nome         String
  razaoSocial  String?              @map("razao_social")
  cnpj         String?              @unique
  telefone     String?
  cidade       String?
  estado       String?
  logoUrl      String?              @map("logo_url")
  criadoEm     DateTime             @default(now()) @map("criado_em")
  atualizadoEm DateTime             @updatedAt @map("atualizado_em")

  usuarios     Usuario[]
  layouts      ConfiguracaoLayout[]

  @@map("clinicas")
}

model Usuario {
  id                String               @id @default(cuid())
  email             String               @unique
  nome              String
  role              String               @default("veterinario")
  crmv              String?
  nomeClinica       String?              @map("nome_clinica")
  logoUrl           String?              @map("logo_url")
  assinaturaUrl     String?              @map("assinatura_url")
  foto              String?
  telefone          String?
  temaPreferencia   String               @default("system") @map("tema_preferencia")
  ativo             Boolean              @default(true)

  clinicaId         String?              @map("clinica_id")
  clinica           Clinica?             @relation(fields: [clinicaId], references: [id], onDelete: SetNull)

  modelosCriados    ModeloCirurgico[]
  layoutsCriados    ConfiguracaoLayout[]
  examesEmitidos    ExameLaudo[]
  cirurgiasEmitidas RelatorioCirurgico[]
  assinatura        Assinatura?
  perfilLaudo       PerfilLaudo?
  perfilCirurgico   PerfilCirurgico?

  criadoEm          DateTime             @default(now()) @map("criado_em")
  atualizadoEm      DateTime             @updatedAt @map("atualizado_em")

  @@index([email])
  @@index([role])
  @@map("usuarios")
}

model ConfiguracaoLayout {
  id                    String   @id @default(cuid())
  nome                  String   @default("Padrão Oficial")
  isPadrao              Boolean  @default(false) @map("is_padrao")

  usuarioId             String?  @unique @map("usuario_id")
  usuario               Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  clinicaId             String?  @map("clinica_id")
  clinica               Clinica? @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  fontFamily            String   @default("Calibri, sans-serif") @map("font_family")
  fontSizeBody          String   @default("11pt") @map("font_size_body")
  fontSizeTitulo        String   @default("14pt") @map("font_size_titulo")
  marginTop             String   @default("20mm") @map("margin_top")
  marginBottom          String   @default("20mm") @map("margin_bottom")
  marginLeft            String   @default("15mm") @map("margin_left")
  marginRight           String   @default("15mm") @map("margin_right")
  lineHeight            String   @default("1.4") @map("line_height")
  paragraphSpacing      String   @default("8pt") @map("paragraph_spacing")

  corPrimaria           String   @default("#1B365D") @map("cor_primaria")
  corSecundaria         String   @default("#4A777A") @map("cor_secundaria")

  // Clonagem Visual e Textual a partir de 1 a 10 PDFs do Médico Veterinário
  modoTemplate          String   @default("padrao_upa") @map("modo_template")
  headerBannerUrl       String?  @map("header_banner_url")
  footerLogoUrl         String?  @map("footer_logo_url")
  assinaturaExtraidaUrl String?  @map("assinatura_extraida_url")
  visualConfigJson      Json?    @map("visual_config_json")
  writingStyleJson      Json?    @map("writing_style_json")
  pdfsReferenciaQtd     Int      @default(0) @map("pdfs_referencia_qtd")

  criadoEm              DateTime @default(now()) @map("criado_em")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em")

  @@index([usuarioId])
  @@index([isPadrao])
  @@map("configuracoes_layout")
}

model ModeloCirurgico {
  id                      String   @id
  isGlobal                Boolean  @default(false) @map("is_global")

  usuarioId               String?  @map("usuario_id")
  usuario                 Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome                    String
  sinonimos               String[]
  procedimento            String
  diagnosticoPreCirurgico String?  @map("diagnostico_pre_cirurgico")
  descricaoProcedimento   String   @db.Text @map("descricao_procedimento")
  evolucaoConsideracoes   String?  @db.Text @map("evolucao_consideracoes")

  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  @@index([usuarioId])
  @@index([isGlobal])
  @@index([nome])
  @@map("modelos_cirurgicos")
}

model ExameLaudo {
  id               String   @id @default(cuid())
  usuarioId        String   @map("usuario_id")
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pacienteNome     String   @map("paciente_nome")
  pacienteEspecie  String   @map("paciente_especie")
  pacienteSexo     String?  @map("paciente_sexo")
  pacienteIdade    String?  @map("paciente_idade")
  tutorNome        String?  @map("tutor_nome")
  dataExame        String   @map("data_exame")

  laudoEstruturado Json     @map("laudo_estruturado")
  imagensQtd       Int      @default(0) @map("imagens_qtd")

  pdfArquivo       String?  @map("pdf_arquivo")
  docxArquivo      String?  @map("docx_arquivo")

  criadoEm         DateTime @default(now()) @map("criado_em")

  @@index([usuarioId])
  @@index([pacienteNome])
  @@index([criadoEm])
  @@map("exames_laudos")
}

model RelatorioCirurgico {
  id              String   @id @default(cuid())
  usuarioId       String   @map("usuario_id")
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pacienteNome    String   @map("paciente_nome")
  pacienteEspecie String?  @map("paciente_especie")
  procedimento    String
  diagnostico     String?
  modeloUtilizado String?  @map("modelo_utilizado")

  dadosCirurgia   Json     @map("dados_cirurgia")
  possuiFoto      Boolean  @default(false) @map("possui_foto")

  pdfArquivo      String?  @map("pdf_arquivo")
  docxArquivo     String?  @map("docx_arquivo")

  criadoEm        DateTime @default(now()) @map("criado_em")

  @@index([usuarioId])
  @@index([pacienteNome])
  @@index([criadoEm])
  @@map("relatorios_cirurgicos")
}

model Assinatura {
  id             String    @id @default(cuid())
  usuarioId      String    @unique @map("usuario_id")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  plano          String    @default("PRO") // GRATUITO, TRIAL, SOLO, PRO, CLINICA
  status         String    @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELED
  precoMensal    Decimal   @default(149.00) @map("preco_mensal") @db.Decimal(10, 2)
  ciclo          String    @default("mensal") // mensal ou anual
  cotaLimite     Int       @default(150) @map("cota_limite")
  cicloInicio    DateTime  @default(now()) @map("ciclo_inicio")
  cicloFim       DateTime  @map("ciclo_fim")

  cartaoFinal          String?   @map("cartao_final")
  cartaoBandeira       String?   @map("cartao_bandeira")

  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")

  criadoEm             DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  faturas        Fatura[]

  @@map("assinaturas")
}

model Fatura {
  id           String     @id @default(cuid())
  assinaturaId String     @map("assinatura_id")
  assinatura   Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  valor        Decimal    @db.Decimal(10, 2)
  status       String     @default("pago") // pago, pendente, cancelado
  dataFatura   DateTime   @default(now()) @map("data_fatura")
  descricao        String?
  pdfUrl           String?    @map("pdf_url")
  stripeInvoiceId  String?    @unique @map("stripe_invoice_id")
  hostedInvoiceUrl String?    @map("hosted_invoice_url")

  criadoEm         DateTime   @default(now()) @map("criado_em")

  @@index([assinaturaId])
  @@index([dataFatura])
  @@map("faturas")
}

model StripeWebhookEvent {
  id           String   @id
  tipo         String
  processadoEm DateTime @default(now()) @map("processado_em")

  @@map("stripe_webhook_events")
}

model TelemetriaEdicaoLaudo {
  id            String   @id @default(cuid())
  jobId         String   @map("job_id")
  exameId       String?  @map("exame_id")
  usuarioId     String   @map("usuario_id")
  orgao         String
  tipoEdicao    String   @map("tipo_edicao")
  iaDisseNormal Boolean  @default(false) @map("ia_disse_normal")
  textoAntes    String?  @db.Text @map("texto_antes")
  textoDepois   String?  @db.Text @map("texto_depois")
  diagDifAntes  String?  @map("diag_dif_antes")
  diagDifDepois String?  @map("diag_dif_depois")
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@unique([jobId, orgao])
  @@index([orgao])
  @@index([usuarioId])
  @@index([iaDisseNormal])
  @@index([criadoEm])
  @@map("telemetria_edicoes_laudo")
}

model PerfilLaudo {
  id                    String    @id @default(cuid())
  usuarioId             String    @unique @map("usuario_id")
  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  ativo                 Boolean   @default(true)
  status                String    @default("aprendido") // pendente, processando, aprendido, erro
  quantidadeAmostras    Int       @default(0) @map("quantidade_amostras")
  arquivosAmostras      Json?     @map("arquivos_amostras")

  ordemOrgaos           String[]  @default([]) @map("ordem_orgaos")
  vocabularioPreferido  Json?     @map("vocabulario_preferido")
  frasesNormalidade     Json?     @map("frases_normalidade")
  estiloConclusao       String?   @db.Text @map("estilo_conclusao")
  observacoesEstilo     String?   @db.Text @map("observacoes_estilo")

  nomeDetectado         String?   @map("nome_detectado")
  crmvDetectado         String?   @map("crmv_detectado")
  clinicaDetectada      String?   @map("clinica_detectada")
  layoutDetectado       Json?     @map("layout_detectado")
  templateVisual        Json?     @map("template_visual")

  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  @@index([usuarioId])
  @@map("perfis_laudo")
}

model PerfilCirurgico {
  id                    String    @id @default(cuid())
  usuarioId             String    @unique @map("usuario_id")
  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  ativo                 Boolean   @default(true)
  status                String    @default("aprendido")
  quantidadeAmostras    Int       @default(0) @map("quantidade_amostras")
  arquivosAmostras      Json?     @map("arquivos_amostras")

  ordemSecoes           String[]  @default([]) @map("ordem_secoes")
  estiloRedacao         Json?     @map("estilo_redacao")
  vocabularioPreferido  Json?     @map("vocabulario_preferido")
  observacoesEstilo     String?   @db.Text @map("observacoes_estilo")

  nomeDetectado         String?   @map("nome_detectado")
  crmvDetectado         String?   @map("crmv_detectado")
  clinicaDetectada      String?   @map("clinica_detectada")
  layoutDetectado       Json?     @map("layout_detectado")
  templateVisual        Json?     @map("template_visual")

  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  @@index([usuarioId])
  @@map("perfis_cirurgia")
}
