# ==============================================================================
# VETARO SAAS — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Servidor & Banco
PORT=3000
APP_BASE_URL=https://vetaro.com.br
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vetaro
JWT_SECRET=troque_por_uma_chave_secreta_forte

# IA & Autenticação Google
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GEMINI_USE_HYDROGEN_PAID=true
GOOGLE_CLIENT_ID=

# ==============================================================================
# STRIPE (Payments + Billing + Invoicing)
# ==============================================================================
# Chave secreta da API (use sk_test_... em homologação e sk_live_... em produção)
STRIPE_SECRET_KEY=

# Signing secret do Webhook (whsec_...) criado em Developers -> Webhooks
# Endpoint em produção: https://vetaro.com.br/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# IDs de Preço (price_...) gerados no Stripe Dashboard ou via:
#   node scripts/setup-stripe-products.js
STRIPE_PRICE_SOLO_MENSAL=
STRIPE_PRICE_SOLO_ANUAL=
STRIPE_PRICE_PRO_MENSAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRICE_CLINICA_MENSAL=
STRIPE_PRICE_CLINICA_ANUAL=
